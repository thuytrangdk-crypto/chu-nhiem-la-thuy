# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL of your Supabase project (e.g. https://xyz.supabase.co)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# SUPABASE_ANON_KEY: Public/anon key of your Supabase project
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Privileged server-side key for backend API access.
# Required for secure environments when public anon access is restricted via RLS.
# NEVER expose this key to client-side code or public repositories.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# SESSION_SECRET: Secret key used for signing and verifying JWT/HMAC session tokens.
# Must be configured in environment variables. Do NOT hardcode or share.
SESSION_SECRET="your-secure-random-secret-key-at-least-32-chars"
